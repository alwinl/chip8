{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trunk: Full clang-tidy scan",
      "type": "process",
      "command": "trunk",
      "args": ["check", "--all"],
      "problemMatcher": {
        "owner": "trunk-full-scan",
        "source": "Trunk clang-tidy",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "warning",
        "pattern": [
          {
            "regexp": "^([^\\s].*):\\d+:\\d+\\s*$",
            "file": 1
          },
          {
            "regexp": "^\\s*(\\d+):(\\d+)\\s+(?:low|medium|high)\\s+(.*?)\\s{2,}(clang-tidy(?:/[^\\s]+)?)\\s*$",
            "line": 1,
            "column": 2,
            "message": 3,
            "code": 4,
            "loop": true
          }
        ]
      },
      "presentation": {
        "reveal": "always",
        "revealProblems": "onProblem",
        "panel": "dedicated"
      }
    }
  ]
}
