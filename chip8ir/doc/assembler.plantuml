@startuml assembler
title Assembler sequence

actor User
participant Assembler
participant Loader
participant Tokeniser
participant Parser
participant SymbolCollector
participant IRGenerator

User -> Assembler ++: build_ir( stream )

Assembler -> Loader ++ : load_assembly_source( stream )
return ASMSource

Assembler -> Tokeniser ++ : tokenise_assembly( ASMSource)
return ASMTokens

Assembler -> Parser ++ : parse_asm_tokens( ASMTokens )
return ASTProgram

Assembler -> SymbolCollector ++ : collect_symbols( ASTProgram )
return SymbolTable

Assembler -> IRGenerator ++ : generate_ir( ASTProgram, SymbolTable )
return IRProgram

return IRBundle { IRProgram, SymbolTable }

hide footbox

@enduml