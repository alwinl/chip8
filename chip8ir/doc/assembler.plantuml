@startuml assembler
title Assembler sequence

actor User
participant Assembler
participant Tokeniser
participant ASMParser

User -> Assembler ++: build_ir( ASMSource )

Assembler -> Tokeniser ++ : tokenise_assembly( ASMSource)
return ASMTokens

Assembler -> ASMParser ++ : parse_asm_tokens( ASMTokens )
return ASTProgram

Assembler ->Assembler ++ : collect_symbols( ASTProgram )
return

Assembler -> Assembler ++ : generate_ir( ASTProgram )
return

return IRProgram

hide footbox

@enduml